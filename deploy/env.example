# The NON-secret settings of the production stack. Copy to /opt/chat-app/.env on the EC2 instance
# and fill in the values. Secrets (JWT_SECRET, MESSAGE_KEYS, POSTGRES_PASSWORD, DATABASE_URL) are
# never written here: deploy.sh fetches them from AWS SSM Parameter Store on every deployment.

# <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.eu-central-1.amazonaws.com

# The domain pointing at the instance (Caddy then serves HTTPS), or ":80" to serve plain HTTP on the IP.
SITE_ADDRESS=:80

NODE_ENV=production

# Which key of MESSAGE_KEYS encrypts new messages
MESSAGE_KEY_ID=1

# No S3 keys and no endpoint: the api talks to AWS and uses the instance role.
S3_BUCKET=chat-app-attachments-change-me
# Also the region of ECR and SSM in deploy.sh
S3_REGION=eu-central-1
