{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,

    // Legacy relaxations: the old Mongo-based code was never strict.
    // They are removed in Step 7 when the api is rewritten under `strict: true`.
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noImplicitOverride": false
  }
}
