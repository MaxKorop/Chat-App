# Copy to `.env`. Used by the api (running with `pnpm dev`, or in the compose `full` profile).
NODE_ENV=development
PORT=3000

# Matches docker-compose.yml
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Message encryption key ring: "<id>:<base64 of 32 random bytes>[,<id>:<...>]"
# Generate one with:  echo "1:$(openssl rand -base64 32)"
# Losing this key makes every stored message unreadable, so back it up outside the repo.
MESSAGE_KEYS=
# Which key id encrypts NEW messages (old ones still decrypt with their own key id)
MESSAGE_KEY_ID=1

# S3-compatible storage (SeaweedFS locally, AWS S3 in production)
S3_BUCKET=chat-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:8333
# The address the BROWSER can reach (differs from S3_ENDPOINT inside containers)
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Must match docker/s3.json for the local SeaweedFS. In production leave these out: the EC2 instance role is used.
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
