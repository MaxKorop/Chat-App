{
  "name": "chat-app",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @chat/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @chat/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @chat/shared build && pnpm test:repo && pnpm -r test",
    "test:repo": "node --test \"tooling/**/*.test.mjs\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "node tooling/install-hooks.mjs",
    "infra:up": "docker compose up -d --wait postgres s3",
    "infra:down": "docker compose down",
    "test:int": "pnpm --filter @chat/api test:int",
    "db:migrate": "pnpm --filter @chat/api db:migrate",
    "db:seed": "pnpm --filter @chat/api db:seed",
    "test:cov": "pnpm --filter @chat/api test:cov"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2"
}
