# Host ports for `docker compose`. Copy this file to `.env` and change a value if its default
# port is already taken on your machine (for example by another Postgres).
#
# If you change POSTGRES_PORT, change the port in DATABASE_URL (apps/api/.env) as well.
# If you change S3_PORT, change S3_ENDPOINT and S3_PUBLIC_ENDPOINT (apps/api/.env) as well.
POSTGRES_PORT=5432
S3_PORT=8333
WEB_PORT=8080
