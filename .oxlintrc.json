{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "env": { "browser": true, "node": true, "es2024": true },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "typescript/no-explicit-any": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }],

    // Too noisy for this stack: CSS side-effect imports, empty decorated Nest modules,
    // Mongo's `_id` (gone after the Prisma migration).
    "import/no-unassigned-import": "off",
    "typescript/no-extraneous-class": "off",
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      // LEGACY CODE: the old Mongo api and antd/MobX UI. These errors are downgraded to warnings
      // so the repo can lint cleanly today. DELETE this block when the code is gone:
      // api paths in Step 7, web paths in Step 14.
      "files": [
        "apps/api/src/{chat,image,user,pipes,guards,strategies}/**",
        "apps/api/src/app.module.ts",
        "apps/web/src/{components,store,http,types,hooks}/**",
        "apps/web/src/App.tsx"
      ],
      "rules": {
        "no-unused-vars": "warn",
        "typescript/no-wrapper-object-types": "warn",
        "jsx-a11y/click-events-have-key-events": "warn",
        "jsx-a11y/no-static-element-interactions": "warn",
        "jsx-a11y/no-autofocus": "warn",
        "jsx-a11y/img-redundant-alt": "warn",
        "react/set-state-in-effect": "warn",
        "react/static-components": "warn"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/generated/**",
    "**/coverage/**",
    "apps/web/src/components/ui/**"
  ]
}
